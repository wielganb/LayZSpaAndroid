<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMART SPA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#19303E"
        android:gravity="center"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widgetTemp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="58dp"
        android:text="--°"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#1C97DD"
        android:gravity="center"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widgetTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CEL 30°C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#5B6F7C"
        android:gravity="center"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● ROZŁĄCZONO"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#5B6F7C"
        android:gravity="center"
        android:paddingTop="5dp"
        android:includeFontPadding="false" />
</LinearLayout>
