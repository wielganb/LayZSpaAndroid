<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sessionWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMART SPA"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#19303E"
        android:gravity="center"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/sessionWidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SESJA GOTOWA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#5B6F7C"
        android:gravity="center"
        android:paddingTop="6dp"
        android:includeFontPadding="false" />

    <Chronometer
        android:id="@+id/sessionWidgetTimer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="58dp"
        android:text="00:00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#E53935"
        android:gravity="center"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="3dp">

        <TextView
            android:id="@+id/sessionWidgetTemp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--°"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1C97DD"
            android:gravity="center"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/sessionWidgetTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CEL 30°C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#5B6F7C"
            android:gravity="center"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionWidgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● ROZŁĄCZONO"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#5B6F7C"
        android:gravity="center"
        android:paddingTop="4dp"
        android:includeFontPadding="false" />
</LinearLayout>
